#####
# Configuration file for the Constrained Device App (CDA)
#
# This provides a section-based configuration format for use by
# ConfigUtil with keys defined in ConfigConst.
#
# IMPORTANT: Edit this file to meet your local system requirements.
#

#
# MQTT client configuration information
#
[Mqtt.GatewayService]
clientID       = CDA_Mooyeon_Kim
credFile       = ./cred/PiotMqttLocalCred.props
certFile       = ./certs/ca.crt
host           = 100.79.248.40
port           = 1883
securePort     = 8883
defaultQoS     = 0
keepAlive      = 60
enableAuth     = False
enableCrypt    = True

#
# CoAP client configuration information
#
[Coap.GatewayService]
credFile       = ./cred/PiotCoapCred.props
certFile       = ./cert/PiotCoapLocalCertFile.pem
host           = localhost
port           = 5683
securePort     = 5684
enableAuth     = False
enableCrypt    = False

#
# Data configuration information
#
[Data.GatewayService]
host           = localhost
port           = 6380
enableCrypt    = False
credFile       = ./cred/PiotPersistenceCred.props

#
# CDA specific configuration information
#
[ConstrainedDevice]
deviceLocationID = CDA_Mooyeon_Kim
enableEmulator   = False 
enableSenseHAT   = True
enableMqttClient = True
enableCoapServer = False
enableCoapClient = False
enablePersistenceClient = False
enableSystemPerformance = True
enableSensing    = True
enableSimulator  = False
enableLogging    = True
enableCamera = True
pollCycleSecs    = 5
testGdaDataPath  = /tmp/gda-data
testCdaDataPath  = /tmp/cda-data
testEmptyApp     = False
runForever       = True

# configurable limits for sensor simulation
humiditySimFloor   =   35.0
humiditySimCeiling =   45.0
pressureSimFloor   =  990.0
pressureSimCeiling = 1010.0
tempSimFloor       =   15.0
tempSimCeiling     =   25.0

handleHumidityChangeOnDevice = False
triggerHumidifierHumidityFloor = 40.0
triggerHumidifierHumidityCeiling = 60.0
cloudOverrideDurationSecs = 60

# Smart plug account
kasaEmail    = YOURACCOUNT
kasaPassword = YOURPASSWORD

# camera settings
streamHostAddr      = 127.0.0.1
streamHostLabel     = localhost
streamPort          = 8554
streamProtocol      = rtsp
streamPath          = stream
streamEncoding      = MJPG
streamFrameWidth    = 1440
streamFrameHeight   = 1080
streamFps           =   30
imageFileExt        = .png
videoFileExt        = .avi
minMotionPixelsDiff = 10000

# season mode: summer or winter
seasonMode = summer

# summer: AC mode
triggerHvacTempFloor   = 20.0
triggerHvacTempCeiling = 23.0

# winter: heater mode 
# triggerHvacTempFloor   = 24.0
# triggerHvacTempCeiling = 27.0
